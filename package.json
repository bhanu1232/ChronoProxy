{
  "name": "semantic-browser-proxy",
  "version": "1.0.0",
  "description": "Production-ready headless semantic browser proxy with O(1) stream parsing",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/server.ts",
    "start": "node dist/server.js",
    "dashboard": "npx http-server dashboard -p 3000 --cors",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/static": "^6.12.0",
    "@fastify/websocket": "^10.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "htmlparser2": "^9.1.0",
    "ioredis": "^5.3.2",
    "pg": "^8.12.0",
    "playwright": "^1.44.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.5",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
